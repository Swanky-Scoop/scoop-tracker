# Copy to .env (gitignored — never commit real credentials) and fill in.
# Local dev mirror only — see CLAUDE.md's "Local development mirror" section.
SCOOP_BASE_URL=https://ops.swanky.local
SCOOP_TEST_USER=
SCOOP_TEST_PASS=

# Second, LOW-PRIVILEGE login (optional — debt-wanted-readonly.spec.js
# SKIPS without it). The ROLE is what matters, not the account: it must
# resolve a policy that grants Debt GET but has NO Debt POST key
# (ice_cream_maker as of the 2026-08-30 policy change — see
# includes/_policy.php; kiosk is Debt GET:false and hits the view-gate
# instead, exercising nothing). Create once on the mirror, from the Local
# site shell:
#   wp user create scoop-smoke-readonly scoop-smoke-readonly@example.com \
#     --role=ice_cream_maker --user_pass='...'
# Never reuse the admin credential here — the whole point is a role whose
# canPost is genuinely false.
SCOOP_TEST_USER_2=
SCOOP_TEST_PASS_2=
