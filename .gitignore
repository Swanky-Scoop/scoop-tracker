# Local-only / secret config
.vscode/sftp.json
.vscode/sftp.local.json
.claude/settings.local.json

# SSH deploy keys — never commit, never deploy
scoop-deploy-key
scoop-deploy-key.pub
*.pem
*_rsa
*_ed25519
id_*

# DB dumps (WP Migrate exports, import-script backups) — contain live
# customer/business data, never commit. data-exports/ already carries one
# committed .sql.gz from before this rule existed (2026-07-24); leave that
# tracked file alone unless asked to scrub history, just stop new ones.
data-exports/backups/
data-exports/*.sql.gz
data-exports/*.sql

# Scratch / debug artifacts
_domain.json
response.json
1_response.json
fast_response.json
post_response.json
dump.txt

# Local dev-time npm tooling (e.g. icon-font-generator) — never deployed,
# see deploy.yml's rsync excludes. package.json/package-lock.json stay
# tracked as documentation of what's used; only the installed tree is ignored.
node_modules/

# Regenerated every `npm run build:icons` run (see scripts/normalize-icon-svgs.js)
# — stroke-outlined copies of assets/icon-font/svg/, not source, never committed.
assets/icon-font/.normalized/

# Playwright visual test run output (tests/visual/README.md) — regenerated
# every run, not source. The baseline PNGs under tests/visual/tests/
# *-snapshots/ are NOT covered by this and stay tracked; they're the whole
# point of the suite.
tests/visual/test-results/
tests/visual/playwright-report/
tests/visual/blob-report/

# Playwright MCP session artifacts (snapshots/console logs from ad-hoc
# browser-driven debugging, not the visual test suite above) — regenerated
# per session, not source.
.playwright-mcp/
